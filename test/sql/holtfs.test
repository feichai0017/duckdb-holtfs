                     '/tmp/duckdb_holtfs_mutable_index',
                     mode := 'persistent');
----
0	0	1

statement ok
COPY (SELECT 'after-with-a-longer-payload') TO '/tmp/duckdb_holtfs_mutable_source.csv' (FORMAT CSV, HEADER false);

query III
SELECT CAST(changed_files AS INTEGER),
       CAST(missing_files AS INTEGER),
       CAST(is_current AS INTEGER)
FROM holtfs_validate('/tmp/duckdb_holtfs_mutable_source.csv',
                     '/tmp/duckdb_holtfs_mutable_index',
                     mode := 'persistent');
----
1	0	0

query III
SELECT CAST(refreshed_files AS INTEGER),
       CAST(removed_keys AS INTEGER),
       CAST(indexed_files AS INTEGER)
FROM holtfs_refresh('/tmp/duckdb_holtfs_mutable_source.csv',
                    '/tmp/duckdb_holtfs_mutable_index',
                    mode := 'persistent',
                    prefix := '/tmp/duckdb_holtfs_mutable_source.csv');
----
1	0	1

query II
SELECT CAST(changed_files AS INTEGER),
       CAST(is_current AS INTEGER)
FROM holtfs_validate('/tmp/duckdb_holtfs_mutable_source.csv',
                     '/tmp/duckdb_holtfs_mutable_index',
