# name: test/sql/holtfs.test
# description: holtfs extension smoke test
# group: [sql]

require holtfs

require parquet

query I
SELECT holtfs_version() = 'v0.2.0';
----
true

statement error
SELECT * FROM holt_files('/tmp/holtfs-index', delimiter := '//');
----
Binder Error: holtfs delimiter must be empty or a single byte

statement error
SELECT * FROM holt_files('missing_memory_index', mode := 'memory');
----
IO Error: holtfs memory index not found: missing_memory_index

statement error
SELECT * FROM holtfs_status('s3://bucket/index.holt', mode := 'persistent');
----
IO Error: holtfs persistent index_ref must be a local path without glob characters

statement error
SELECT * FROM holtfs_validate('test/fixtures/holtfs', '/tmp/duckdb_holtfs_sql_index', mode := 'bad');
----
Binder Error: holtfs mode must be 'persistent' or 'memory'

statement error
SELECT *
FROM holtfs_index('test/fixtures/holtfs',
                  mode := 'memory',
                  name := 'bad_refresh_arg',
                  refresh := 'replace');
----
Binder Error: Invalid named parameter "refresh" for function holtfs_index

statement error
SELECT *
FROM holtfs_index('test/fixtures/holtfs',
                  mode := 'persistent',
                  index_path := 'test/fixtures/holtfs/.holt');
----
IO Error: holtfs index_path must not be source_path or a path inside it

statement error
SELECT *
FROM holtfs_index('test/fixtures/holtfs/',
                  mode := 'persistent',
                  index_path := 'test/fixtures/holtfs/.holt');
----
IO Error: holtfs index_path must not be source_path or a path inside it

statement error
SELECT *
FROM holtfs_index('test/fixtures/holtfs/**/*.parquet',
                  mode := 'persistent',
                  index_path := 'test/fixtures/holtfs/.holt');
----
IO Error: holtfs index_path must not be source_path or a path inside it

statement ok
COPY (SELECT 'keep') TO '{TEMP_DIR}/holtfs_not_an_index' (FORMAT CSV, HEADER false);

statement error
SELECT *
FROM holtfs_index('test/fixtures/holtfs',
                  mode := 'persistent',
                  index_path := '{TEMP_DIR}/holtfs_not_an_index');
----
IO Error: holtfs persistent index not found or incomplete

query I
SELECT count(*) FROM read_csv('{TEMP_DIR}/holtfs_not_an_index', header := false);
----
1

query I
SELECT indexed_files
FROM holtfs_index('test/fixtures/holtfs',
                  mode := 'persistent',
                  index_path := '/tmp/duckdb_holtfs_sql_index');
----
3

query IIII
SELECT CAST(has_manifest AS INTEGER),
       CAST(source_exists AS INTEGER),
       CAST(indexed_files AS INTEGER),
       CAST(is_stale AS INTEGER)
FROM holtfs_status('/tmp/duckdb_holtfs_sql_index',
                   mode := 'persistent',
                   max_age_seconds := 3600);
----
1	1	3	0

statement error
SELECT *
FROM holtfs_status('{TEMP_DIR}/duckdb_holtfs_missing_status',
                   mode := 'persistent');
----
IO Error: holtfs persistent index not found or incomplete: {TEMP_DIR}/duckdb_holtfs_missing_status

query I
SELECT count(*)
FROM holt_files('/tmp/duckdb_holtfs_sql_index',
                mode := 'persistent')
WHERE entry_type = 'key';
----
3

query I
SELECT count(*)
FROM holt_files('/tmp/duckdb_holtfs_sql_index',
                mode := 'persistent',
                prefix := 'test/fixtures/holtfs/bucket/table/date=2026-05-22/part-000.parquet')
WHERE value IS NULL AND version > 0;
----
1

query T
SELECT path
FROM holt_files('/tmp/duckdb_holtfs_sql_index',
                mode := 'persistent',
                prefix := 'test/fixtures/holtfs/bucket/table/',
                start_after := 'test/fixtures/holtfs/bucket/table/date=2026-05-22/part-000.parquet',
                max_files := 1)
WHERE entry_type = 'key';
----
test/fixtures/holtfs/bucket/table/date=2026-05-23/part-000.parquet

query TTI
SELECT entry_type, path, CAST(version > 0 AS INTEGER)
FROM holt_files('/tmp/duckdb_holtfs_sql_index',
                mode := 'persistent',
                prefix := 'test/fixtures/holtfs/bucket/table/',
                delimiter := '/')
ORDER BY path;
----
key	test/fixtures/holtfs/bucket/table/_metadata	1
common_prefix	test/fixtures/holtfs/bucket/table/date=2026-05-22/	0
common_prefix	test/fixtures/holtfs/bucket/table/date=2026-05-23/	0

query TI
SELECT path, CAST(CAST(value AS VARCHAR) LIKE 'size=5;kind=file;mtime_us=%' AS INTEGER)
FROM holt_files('/tmp/duckdb_holtfs_sql_index',
                mode := 'persistent',
                prefix := 'test/fixtures/holtfs/bucket/table/date=2026-05-22/part-000.parquet',
                include_value := true);
----
test/fixtures/holtfs/bucket/table/date=2026-05-22/part-000.parquet	1

query III
SELECT CAST(refreshed_files AS INTEGER),
       CAST(removed_keys AS INTEGER),
       CAST(indexed_files AS INTEGER)
FROM holtfs_refresh('test/fixtures/holtfs',
                    '/tmp/duckdb_holtfs_sql_index',
                    mode := 'persistent',
                    prefix := 'bucket/table/date=2026-05-22');
----
1	0	3

statement error
SELECT *
FROM holtfs_refresh('test/fixtures/holtfs',
                    '/tmp/duckdb_holtfs_sql_index',
                    mode := 'persistent',
                    prefix := '../outside');
----
IO Error: holtfs_refresh prefix must stay within source_path

statement error
SELECT *
FROM holtfs_refresh('test/fixtures/holtfs',
                    '/tmp/duckdb_holtfs_sql_index',
                    mode := 'persistent',
                    prefix := '/tmp');
----
IO Error: holtfs_refresh prefix must stay within source_path

statement error
SELECT *
FROM holtfs_refresh('test/fixtures/holtfs',
                    '/tmp/duckdb_holtfs_sql_index',
                    mode := 'persistent',
                    prefix := 'bucket/*');
----
IO Error: holtfs_refresh prefix must not contain a glob

statement error
SELECT *
FROM holtfs_refresh('test/fixtures/holtfs/bucket/table',
                    '/tmp/duckdb_holtfs_sql_index',
                    mode := 'persistent',
                    prefix := 'date=2026-05-22');
----
IO Error: holtfs source_path does not match the index manifest

query IIIIIII
SELECT CAST(source_exists AS INTEGER),
       CAST(source_files AS INTEGER),
       CAST(indexed_files AS INTEGER),
       CAST(matched_files AS INTEGER),
       CAST(changed_files AS INTEGER),
       CAST(missing_files AS INTEGER),
       CAST(is_current AS INTEGER)
FROM holtfs_validate('test/fixtures/holtfs',
                     '/tmp/duckdb_holtfs_sql_index',
                     mode := 'persistent');
----
1	3	3	3	0	0	1

query I
SELECT indexed_files
FROM holtfs_index('test/fixtures/holtfs/bucket/table/date=2026-05-22',
                  mode := 'persistent',
                  index_path := '/tmp/duckdb_holtfs_sql_index');
----
1

query I
SELECT count(*)
FROM holt_files('/tmp/duckdb_holtfs_sql_index',
                mode := 'persistent',
                prefix := 'test/fixtures/holtfs/bucket/table/date=2026-05-23/');
----
0

query IIIII
SELECT CAST(indexed_files AS INTEGER),
       CAST(matched_files AS INTEGER),
       CAST(changed_files AS INTEGER),
       CAST(missing_files AS INTEGER),
       CAST(is_current AS INTEGER)
FROM holtfs_validate('test/fixtures/holtfs',
                     '/tmp/duckdb_holtfs_sql_index',
                     mode := 'persistent');
----
1	1	0	2	0

query I
SELECT indexed_files
FROM holtfs_index('test/fixtures/holtfs',
                  mode := 'memory',
                  name := 'fixture_memory');
----
3

query III
SELECT CAST(has_manifest AS INTEGER),
       CAST(indexed_files AS INTEGER),
       CAST(is_stale AS INTEGER)
FROM holtfs_status('fixture_memory',
                   mode := 'memory',
                   max_age_seconds := 3600);
----
1	3	0

query III
SELECT CAST(refreshed_files AS INTEGER),
       CAST(removed_keys AS INTEGER),
       CAST(indexed_files AS INTEGER)
FROM holtfs_refresh('test/fixtures/holtfs',
                    'fixture_memory',
                    mode := 'memory');
----
3	0	3

query I
SELECT count(*)
FROM holt_files('fixture_memory',
                mode := 'memory',
                prefix := 'test/fixtures/holtfs/bucket/table/');
----
3

concurrentloop threadid 0 6

loop i 0 20

onlyif threadid=0
statement ok
SELECT *
FROM holtfs_refresh('test/fixtures/holtfs',
                    'fixture_memory',
                    mode := 'memory',
                    prefix := 'bucket/table/date=2026-05-22');

skipif threadid=0
query I
SELECT count(*)
FROM holt_files('fixture_memory',
                mode := 'memory')
WHERE entry_type = 'key';
----
3

endloop

endloop

statement ok
COPY (SELECT 42::INTEGER AS id, 'holt'::VARCHAR AS tag)
TO '{TEMP_DIR}/holtfs_one.parquet' (FORMAT PARQUET);

query I
SELECT indexed_files
FROM holtfs_index('{TEMP_DIR}/holtfs_one.parquet',
                  mode := 'persistent',
                  index_path := '/tmp/duckdb_holtfs_parquet_index');
----
1

query IT
SELECT id, tag
FROM holt_parquet_scan('/tmp/duckdb_holtfs_parquet_index',
                       mode := 'persistent');
----
42	holt

query I
SELECT indexed_files
FROM holtfs_index('{TEMP_DIR}/holtfs_one.parquet',
                  mode := 'memory',
                  name := 'parquet_memory');
----
1

query I
SELECT count(*)
FROM holt_parquet_scan('parquet_memory',
                       mode := 'memory',
                       prefix := '{TEMP_DIR}/',
                       filename := true);
----
1

statement error
SELECT *
FROM holt_parquet_scan('parquet_memory',
                       mode := 'memory',
                       prefix := '{TEMP_DIR}/missing/');
----
IO Error: holt_parquet_scan found no Parquet files for prefix: {TEMP_DIR}/missing/

statement ok
COPY (SELECT 1::INTEGER AS id)
TO '{TEMP_DIR}/holtfs_bound_1.parquet' (FORMAT PARQUET);

query I
SELECT indexed_files
FROM holtfs_index('{TEMP_DIR}/holtfs_bound_*.parquet',
                  mode := 'memory',
                  name := 'bound_plan_memory');
----
1

statement ok
PREPARE holtfs_bound_plan AS
SELECT count(*) FROM holt_parquet_scan('bound_plan_memory', mode := 'memory');

query I
EXECUTE holtfs_bound_plan;
----
1

statement ok
COPY (SELECT 2::INTEGER AS id)
TO '{TEMP_DIR}/holtfs_bound_2.parquet' (FORMAT PARQUET);

query I
SELECT indexed_files
FROM holtfs_rebuild('{TEMP_DIR}/holtfs_bound_*.parquet',
                    'bound_plan_memory',
                    mode := 'memory');
----
2

query I
EXECUTE holtfs_bound_plan;
----
2

query I
SELECT count(*) FROM holt_parquet_scan('bound_plan_memory', mode := 'memory');
----
2

statement ok
DEALLOCATE holtfs_bound_plan;

statement ok
COPY (
  SELECT 1::INTEGER AS id, '2026-05-22'::VARCHAR AS ds
  UNION ALL
  SELECT 2::INTEGER AS id, '2026-05-23'::VARCHAR AS ds
)
TO '{TEMP_DIR}/holtfs_glob_lake' (FORMAT PARQUET, PARTITION_BY ds);

query I
SELECT indexed_files
FROM holtfs_index('{TEMP_DIR}/holtfs_glob_lake/**/*.parquet',
                  mode := 'persistent',
                  index_path := '/tmp/duckdb_holtfs_glob_index');
----
2

query II
SELECT CAST(source_files AS INTEGER),
       CAST(is_current AS INTEGER)
FROM holtfs_validate('{TEMP_DIR}/holtfs_glob_lake/**/*.parquet',
                     '/tmp/duckdb_holtfs_glob_index',
                     mode := 'persistent');
----
2	1

query I
SELECT sum(id)::INTEGER
FROM holt_parquet_scan('/tmp/duckdb_holtfs_glob_index',
                       mode := 'persistent',
                       prefix := '{TEMP_DIR}/holtfs_glob_lake/');
----
3

query I
SELECT count(*)
FROM holt_parquet_scan('/tmp/duckdb_holtfs_glob_index',
                       mode := 'persistent',
                       prefix := '{TEMP_DIR}/holtfs_glob_lake/',
                       max_files := 1);
----
1

query I
SELECT indexed_files
FROM holtfs_rebuild('{TEMP_DIR}/holtfs_glob_lake/**/*.parquet',
                    '/tmp/duckdb_holtfs_glob_index',
                    mode := 'persistent');
----
2

statement error
SELECT *
FROM holtfs_refresh('{TEMP_DIR}/holtfs_glob_lake/**/*.parquet',
                    '/tmp/duckdb_holtfs_glob_index',
                    mode := 'persistent',
                    prefix := '{TEMP_DIR}/holtfs_glob_lake/ds=2026-05-22/');
----
IO Error: holtfs_refresh prefix refresh is not supported for glob source_path; rebuild the index

query IIII
SELECT CAST(source_files AS INTEGER),
       CAST(indexed_files AS INTEGER),
       CAST(matched_files AS INTEGER),
       CAST(is_current AS INTEGER)
FROM holtfs_validate('test/fixtures/holtfs',
                     'fixture_memory',
                     mode := 'memory');
----
3	3	3	1

query III
SELECT CAST(refreshed_files AS INTEGER),
       CAST(removed_keys AS INTEGER),
       CAST(indexed_files AS INTEGER)
FROM holtfs_refresh('test/fixtures/holtfs',
                    'fixture_memory',
                    mode := 'memory',
                    prefix := 'bucket/table/date=2026-05-23');
----
1	0	3

statement ok
COPY (SELECT 'before') TO '/tmp/duckdb_holtfs_mutable_source.csv' (FORMAT CSV, HEADER false);

query I
SELECT indexed_files
FROM holtfs_index('/tmp/duckdb_holtfs_mutable_source.csv',
                  mode := 'persistent',
                  index_path := '/tmp/duckdb_holtfs_mutable_index');
----
1

query III
SELECT CAST(changed_files AS INTEGER),
       CAST(missing_files AS INTEGER),
       CAST(is_current AS INTEGER)
